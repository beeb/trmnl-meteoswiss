<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<style>
  .charts { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; width: 100%; }
  .charts--row { flex-direction: row; }
  .screen--portrait:not(.screen--lg) .charts--row { flex-direction: column; }
  .chart { flex: 4 1 0; min-height: 0; min-width: 0; }
  .chart--secondary { flex-grow: 3; }
  .charts--row .chart--primary { flex-grow: 3; }
  .charts--row .chart--secondary { flex-grow: 2; }
  .forecast { display: flex; flex: none; justify-content: space-around; padding-bottom: 2px; margin-bottom: 6px; border-bottom: 1px dotted black; font-family: TRMNL21; font-size: 21px; white-space: nowrap; }
  .forecast .day, .forecast .head { display: flex; align-items: center; gap: 6px; }
  .forecast .name, .forecast .now { font-weight: 700; }
  .forecast img { width: 36px; height: 36px; }
  /* stacked days, also used on narrow portrait screens where a single row does not fit */
  .forecast--stacked, .screen--portrait:not(.screen--lg) .forecast { font-family: TRMNL16; font-size: 16px; }
  .forecast--stacked .day, .screen--portrait:not(.screen--lg) .forecast .day { flex-direction: column; gap: 0; }
  .forecast--stacked .head, .screen--portrait:not(.screen--lg) .forecast .head { gap: 4px; }
  .forecast--stacked img, .screen--portrait:not(.screen--lg) .forecast img { width: 24px; height: 24px; }
  .forecast--small { font-family: TRMNL16; font-size: 16px; }
  .axis-unit { display: flex; align-items: center; gap: 2px; }
  .axis-unit img { width: 20px; height: 20px; }
  .forecast--small img { width: 28px; height: 28px; }
  .trmnl .screen .highcharts-axis-labels text { font-family: TRMNL16 !important; }
</style>

{% template meteoswiss %}
{%- assign chart_id = "chart-" | append_random -%}
{%- assign chart2_id = "chart-" | append_random -%}
{%- assign freshness_id = "freshness-" | append_random -%}
{%- if layout == "full" -%}
  {%- assign icon_size = 36 -%}
  {%- assign chart_duration = 129600000  -%}
{%- elsif layout == "horizontal" -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- elsif layout == "vertical" -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- else -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- endif -%}
{%- if layout == "horizontal" -%}
  {%- assign tick_px = 80 -%}
{%- elsif layout == "vertical" or layout == "quadrant" -%}
  {%- assign tick_px = 70 -%}
{%- else -%}
  {%- assign tick_px = 55 -%}
{%- endif -%}
{%- if layout == "quadrant" -%}
  {%- assign compact = true -%}
  {%- assign forecast_days = 2 -%}
{%- else -%}
  {%- assign compact = false -%}
  {%- assign forecast_days = 4 -%}
{%- endif -%}
{%- if layout == "quadrant" or layout == "vertical" -%}
  {%- assign unit_labels = true -%}
  {%- assign margin_left = 38 -%}
  {%- assign margin_right = 32 -%}
{%- elsif layout == "horizontal" -%}
  {%- assign unit_labels = false -%}
  {%- assign margin_left = "undefined" -%}
  {%- assign margin_right = "undefined" -%}
{%- else -%}
  {%- assign unit_labels = false -%}
  {%- assign margin_left = 60 -%}
  {%- assign margin_right = 60 -%}
{%- endif -%}
<div class="layout layout--col gap--none">
  <div class="forecast{% if layout == "vertical" %} forecast--stacked{% elsif compact %} forecast--small{% endif %} w--full">
    {%- for day in forecast limit: forecast_days -%}
      <div class="day">
        <span class="head">
          <span class="name">{%- if forloop.first -%}Today{%- else -%}{{ day.dayDate | date: '%a' }}{%- endif -%}</span>
          {%- if forloop.first -%}
            <span class="now">{{ currentWeather.temperature | round }}°</span>
          {%- endif -%}
          <img data-code="{{ day.iconDayV2 }}" />
        </span>
        <span>{{ day.temperatureMin }}°|{{ day.temperatureMax }}°</span>
      </div>
    {%- endfor -%}
  </div>
  <div class="charts{% if layout == "horizontal" %} charts--row{% endif %}">
    <div id="{{ chart_id }}" class="chart chart--primary"></div>
    {%- if layout != "quadrant" -%}
      <div id="{{ chart2_id }}" class="chart chart--secondary"></div>
    {%- endif -%}
  </div>
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss · {{ trmnl.plugin_settings.custom_fields_values.location_name }}</span>
  <span class="instance" id="{{ freshness_id }}"></span>
</div>
<script>
(() => {
  {%- assign now = 'now' | date: '%s' | minus: 3600 | times: 1000 -%}
  {%- assign end = now | plus: chart_duration -%}
  const fillPatterns = [1, 2, 3, 4, 5, 6].map((n) => ({
    pattern: {
      image: `https://trmnl.com/images/grayscale/gray-${n}.png`,
      width: 12,
      height: 12
    }
  }));

  // Weather Icons by Erik Flowers, as hosted by TRMNL
  const ICON_BASE = 'https://trmnl.com/images/plugins/weather/wi-';

  // MeteoSwiss weather code -> Weather Icons name
  const weatherIcons = {
    '1': 'day-sunny',
    '2': 'day-sunny-overcast',
    '3': 'day-cloudy',
    '4': 'day-cloudy',
    '5': 'cloudy',
    '6': 'day-sleet',
    '7': 'day-rain-mix',
    '8': 'day-snow',
    '9': 'day-showers',
    '10': 'day-rain-mix',
    '11': 'day-snow-wind',
    '12': 'day-lightning',
    '13': 'day-storm-showers',
    '14': 'showers',
    '15': 'night-sleet',
    '16': 'snow-wind',
    '17': 'rain',
    '18': 'sleet',
    '19': 'snow',
    '20': 'rain',
    '21': 'rain-mix',
    '22': 'snow',
    '23': 'thunderstorm',
    '24': 'thunderstorm',
    '25': 'thunderstorm',
    '26': 'day-cloudy-high',
    '27': 'day-haze',
    '28': 'fog',
    '29': 'day-sleet',
    '30': 'day-snow-wind',
    '31': 'day-rain-mix',
    '32': 'day-showers',
    '33': 'day-rain',
    '34': 'day-snow',
    '35': 'cloudy',
    '36': 'day-sleet-storm',
    '37': 'day-snow-thunderstorm',
    '38': 'day-storm-showers',
    '39': 'day-snow-thunderstorm',
    '40': 'lightning',
    '41': 'day-lightning',
    '42': 'day-snow-thunderstorm',
    '51': 'night-clear',
    '52': 'night-alt-partly-cloudy',
    '53': 'night-alt-cloudy',
    '54': 'night-alt-cloudy',
    '55': 'cloudy',
    '56': 'night-alt-sleet',
    '57': 'night-alt-rain-mix',
    '58': 'night-alt-snow',
    '59': 'night-alt-showers',
    '60': 'night-alt-rain-mix',
    '61': 'night-alt-snow',
    '62': 'night-alt-lightning',
    '63': 'night-alt-storm-showers',
    '64': 'showers',
    '65': 'rain-mix',
    '66': 'snow',
    '67': 'rain',
    '68': 'rain-mix',
    '69': 'snow',
    '70': 'rain',
    '71': 'rain-mix',
    '72': 'snow',
    '73': 'storm-showers',
    '74': 'storm-showers',
    '75': 'storm-showers',
    '76': 'night-alt-cloudy-high',
    '77': 'night-fog',
    '78': 'fog',
    '101': 'night-clear',
    '102': 'night-alt-partly-cloudy',
    '103': 'night-alt-cloudy',
    '104': 'night-alt-cloudy',
    '105': 'cloudy',
    '106': 'night-alt-sleet',
    '107': 'night-alt-rain-mix',
    '108': 'night-alt-snow',
    '109': 'night-alt-showers',
    '110': 'night-alt-rain-mix',
    '111': 'night-alt-snow',
    '112': 'night-alt-lightning',
    '113': 'night-alt-storm-showers',
    '114': 'showers',
    '115': 'rain-mix',
    '116': 'snow',
    '117': 'rain',
    '118': 'rain-mix',
    '119': 'snow',
    '120': 'rain',
    '121': 'rain-mix',
    '122': 'snow',
    '123': 'storm-showers',
    '124': 'storm-showers',
    '125': 'storm-showers',
    '126': 'night-alt-cloudy-high',
    '127': 'night-fog',
    '128': 'fog',
    '129': 'night-alt-sleet',
    '130': 'night-alt-snow-wind',
    '131': 'night-alt-rain-mix',
    '132': 'night-alt-showers',
    '133': 'night-alt-rain',
    '134': 'night-alt-snow',
    '135': 'cloudy',
    '136': 'night-alt-sleet-storm',
    '137': 'night-alt-snow-thunderstorm',
    '138': 'night-alt-thunderstorm',
    '139': 'night-alt-snow-thunderstorm',
    '140': 'night-alt-lightning',
    '141': 'night-alt-lightning',
    '142': 'night-alt-snow-thunderstorm',
  };

  function iconTag(src, size) {
    const img = size ? new Image(size, size) : new Image();
    img.src = src;
    return img.outerHTML;
  }

  function weatherIconUrl(code) {
    const name = weatherIcons[code];
    return name ? `${ICON_BASE}${name}.svg` : null;
  }

  document.querySelectorAll('.forecast img').forEach((img) => {
    const src = weatherIconUrl(img.dataset.code);
    if (src) img.src = src;
  });

  const TIMEZONE = '{{ trmnl.user.time_zone_iana | default: "Europe/Zurich" }}';

  // dotted lines at local midnights
  const time = new Highcharts.Time({ timezone: TIMEZONE });
  const midnightLines = [];
  for (let t = Math.floor({{ now }} / 3600000) * 3600000; t <= {{ end }}; t += 3600000) {
    if (time.dateFormat('%H', t) === '00') {
      midnightLines.push({ value: t, color: 'black', dashStyle: 'Dot' });
    }
  }

  // time of the forecast data, then time the screen was drawn
  const dataTime = time.dateFormat('%H:%M', {{ currentWeather.time }});
  const drawnTime = time.dateFormat('%H:%M', {{ trmnl.system.timestamp_utc | times: 1000 }});
  document.getElementById('{{ freshness_id }}').textContent = `${dataTime} (${drawnTime})`;

  Highcharts.setOptions({
    time: {
      timezone: TIMEZONE
    },
    chart: {
      spacing: [4, 0, 4, 0],
      style: {
        fontFamily: "NicoClean",
        fontWeight: 400
      }
    },
    xAxis: {
      lineColor: 'black',
      tickWidth: 1,
      tickLength: 4,
      tickColor: 'black',
      labels: {
        style: {
          color: 'black',
          textOverflow: 'none',
          whiteSpace: 'nowrap'
        }
      }
    },
    yAxis: {
      lineColor: 'black',
      tickWidth: 1,
      tickLength: 4,
      tickColor: 'black',
      labels: {
        {%- if layout != "full" -%}
          distance: 6,
        {%- endif -%}
        style: {
          color: 'black',
          textOverflow: 'none'
        }
      },
      title: {
        {%- if layout == "horizontal" -%}
          margin: 4,
        {%- endif -%}
        style: {
          fontFamily: 'TRMNL12',
          fontSize: '12px',
          whiteSpace: 'nowrap'
        }
      }
    },
    plotOptions: {
      area: {
        animation: false
      }
    }
  });

  Highcharts.chart('{{ chart_id }}', {
    lang: {
      locale: 'en-GB'
    },
    chart: {
      zooming: {
        type: 'xy'
      },
      animation: false,
      {%- if unit_labels -%}
        spacingTop: 24,
      {%- else -%}
        spacingTop: 10,
      {%- endif -%}
      marginLeft: {{ margin_left }},
      marginRight: {{ margin_right }}
    },
    xAxis: [
      {
        type: 'datetime',
        tickPixelInterval: {{ tick_px }},
        dateTimeLabelFormats: {
          hour: '%[HM]',
          day: '%[eb]'
        },
        labels: {
          style: {
            fontSize: '16px'
          },
          autoRotation: undefined
        },
        plotLines: midnightLines
      }
    ],
    yAxis: [
      {

        // Primary yAxis
        labels: {
          style: {
            fontSize: '16px'
          }
        },
        alignTicks: false,
        lineWidth: 1,
        gridLineWidth: 0,
        plotLines: [
          {
            value: 0,
            color: 'black',
            dashStyle: 'Dot'
          },
          {
            value: 20,
            color: 'black',
            dashStyle: 'Dot'
          }, {
            value: 30,
            color: 'black',
            dashStyle: 'Dot'
          }
        ],
        title: {
          {%- if unit_labels -%}
            text: `<span class="axis-unit">${iconTag(ICON_BASE + 'thermometer.svg')}°C</span>`,
            useHTML: true,
            align: 'high',
            rotation: 0,
            offset: 0,
            x: {{ 45 | minus: margin_left }},
            y: -14,
          {%- else -%}
            text: 'Temp. [°C]',
          {%- endif -%}
          style: {
            color: 'black'
          }
        }
      }, {

        // Secondary yAxis
        title: {
          {%- if unit_labels -%}
            text: `<span class="axis-unit">${iconTag(ICON_BASE + 'raindrop.svg')}mm/h</span>`,
            useHTML: true,
            align: 'high',
            rotation: 0,
            offset: 0,
            x: {{ margin_right | minus: 67 }},
            y: -14,
          {%- else -%}
            text: {% if layout == "horizontal" %}'Rain [mm/h]'{% else %}'Precip. [mm/h]'{% endif %},
          {%- endif -%}
          style: {
            color: 'black'
          }
        },
        alignTicks: false,
        lineWidth: 1,
        gridLineWidth: 0,
        labels: {
          style: {
            fontSize: '16px'
          }
        },
        opposite: true,
        min: 0,
        minRange: 5
      }
    ],
    tooltip: {
      shared: true
    },
    legend: {
      align: 'left',
      verticalAlign: 'top'
    },
    title: false,
    credits: {
      enabled: false
    },
    legend: {
      enabled: false
    },
    plotOptions: {
      series: {
        animation: false
      },
      line: {
        marker: {
          enabled: false
        }
      }
    },
    series: [
      {
        name: 'Precipitation < 1',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[5],
        lineWidth: 0,
        zIndex: 6,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 1 }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 1 }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation 1-2',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[4],
        lineWidth: 0,
        zIndex: 5,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 2 }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 2 }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation 2-4',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[3],
        lineWidth: 0,
        zIndex: 4,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 4 }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 4 }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation 4-6',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[2],
        lineWidth: 0,
        zIndex: 3,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 6 }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 6 }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation 6-10',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[1],
        lineWidth: 0,
        zIndex: 2,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 10 }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p | at_most: 10 }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation >10',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: fillPatterns[0],
        lineWidth: 1,
        lineColor: 'black',
        zIndex: 1,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitation10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitation1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Precipitation outline',
        type: 'area',
        step: 'left',
        allowDecimals: true,
        yAxis: 1,
        color: 'transparent',
        lineWidth: 1,
        lineColor: 'black',
        zIndex: 7,
        data: [
          {%- assign last_timestamp = now -%}
          {%- for p in graph.precipitationMax10m -%}
            {%- assign offset = forloop.index0 | times: 600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p }}],
                {%- assign last_timestamp = timestamp -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          /* low res */
          {%- for p in graph.precipitationMax1h -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.startLowResolution | plus: offset -%}
            {%- if timestamp > last_timestamp -%}
              {%- if timestamp <= end -%}
                [{{ timestamp }}, {{ p }}],
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }, {
        name: 'Temperature',
        type: 'line',
        color: 'black',
        zIndex: 8,
        data: [
          {%- for t in graph.temperatureMean1h -%}
            {%- assign symbolIndex = forloop.index0 | divided_by: 3 -%}
            {%- assign showSymbol = forloop.index0 | modulo: 3 -%}
            {%- assign offset = forloop.index0 | times: 3600000 -%}
            {%- assign timestamp = graph.start | plus: offset -%}
            {%- if timestamp >= now -%}
              {%- if timestamp <= end -%}
                {x: {{ timestamp }}, y: {{ t }}, name: '{%- if showSymbol == 0 -%}{{ graph.weatherIcon3hV2[symbolIndex] }}{%- endif -%}'},
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        ],
        dataLabels: {
          enabled: true,
          useHTML: true,
          y: -10000,
          align: 'left',
          formatter: function() {
            const src = this.point.name ? weatherIconUrl(this.point.name) : null;
            return src ? iconTag(src, {{ icon_size }}) : '';
          }
        }
      }
    ]
  });
  {%- if layout != "quadrant" -%}
    Highcharts.chart('{{ chart2_id }}', {
      lang: {
        locale: 'en-GB'
      },
      chart: {
        zooming: {
          type: 'xy'
        },
        animation: false,
        {%- if unit_labels -%}
          spacingTop: 24,
        {%- else -%}
          spacingTop: 10,
        {%- endif -%}
        marginLeft: {{ margin_left }},
        marginRight: {{ margin_right }},
      },
      xAxis: [
        {
          type: 'datetime',
          tickPixelInterval: {{ tick_px }},
          dateTimeLabelFormats: {
            hour: '%[HM]',
            day: '%[eb]'
          },
          labels: {
            style: {
              fontSize: '16px'
            },
            autoRotation: undefined
          },
          plotLines: midnightLines
        }
      ],
      yAxis: [
        {

          // Primary yAxis
          labels: {
            style: {
              fontSize: '16px'
            }
          },
          alignTicks: false,
          lineWidth: 1,
          gridLineWidth: 0,
          title: {
            {%- if unit_labels -%}
              text: `<span class="axis-unit">${iconTag(ICON_BASE + 'strong-wind.svg')}km/h</span>`,
              useHTML: true,
              align: 'high',
              rotation: 0,
              offset: 0,
              x: {{ 62 | minus: margin_left }},
              y: -14,
            {%- else -%}
              text: 'Wind [km/h]',
            {%- endif -%}
            style: {
              color: 'black'
            }
          }
        }, {
          // Secondary yAxis
          title: {
            {%- if unit_labels -%}
              text: `<span class="axis-unit">${iconTag(ICON_BASE + 'day-sunny.svg')}min/h</span>`,
              useHTML: true,
              align: 'high',
              rotation: 0,
              offset: 0,
              x: {{ margin_right | minus: 67 }},
              y: -14,
            {%- else -%}
              text: 'Sun [min/h]',
            {%- endif -%}
            style: {
              color: 'black'
            }
          },
          alignTicks: false,
          lineWidth: 1,
          gridLineWidth: 0,
          labels: {
            style: {
              fontSize: '16px'
            }
          },
          opposite: true,
          tickInterval: 15,
          min: 0,
          max: 60
        }
      ],
      tooltip: {
        shared: true
      },
      legend: {
        align: 'left',
        verticalAlign: 'top'
      },
      title: false,
      credits: {
        enabled: false
      },
      legend: {
        enabled: false
      },
      plotOptions: {
        series: {
          animation: false
        },
        line: {
          marker: {
            enabled: false
          }
        }
      },
      series: [
        {
          name: 'Sunshine',
          type: 'area',
          step: 'left',
          allowDecimals: true,
          yAxis: 1,
          color: fillPatterns[4],
          lineWidth: 1,
          lineColor: 'black',
          marker: false,
          zIndex: 1,
          data: [
            {%- for s in graph.sunshine1h -%}
              {%- assign offset = forloop.index0 | times: 3600000 -%}
              {%- assign timestamp = graph.start | plus: offset -%}
              {%- if timestamp >= now -%}
                {%- if timestamp <= end -%}
                  [{{ timestamp }}, {{ s }}],
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }, {
          name: 'Wind',
          type: 'line',
          color: 'black',
          zIndex: 3,
          data: [
            {%- for w in graph.windSpeed1h -%}
              {%- assign offset = forloop.index0 | times: 3600000 -%}
              {%- assign timestamp = graph.start | plus: offset -%}
              {%- if timestamp >= now -%}
                {%- if timestamp <= end -%}
                  [{{ timestamp }}, {{ w }}],
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }, {
          name: 'Gust',
          type: 'line',
          color: '#666666',
          zIndex: 2,
          data: [
            {%- for g in graph.gustSpeed1h -%}
              {%- assign offset = forloop.index0 | times: 3600000 -%}
              {%- assign timestamp = graph.start | plus: offset -%}
              {%- if timestamp >= now -%}
                {%- if timestamp <= end -%}
                  [{{ timestamp }}, {{ g }}],
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      ]
    });
  {%- endif -%}
})();
</script>
{% endtemplate %}
