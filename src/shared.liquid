<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<style>
  .chart--primary { flex-grow: 4; }
  .chart--secondary { flex-grow: 3; }
  .charts--row .chart--primary { flex-grow: 3; }
  .charts--row .chart--secondary { flex-grow: 2; }
  .forecast { white-space: nowrap; }
  .trmnl .screen .highcharts-axis-labels text { font-family: var(--label-font-family) !important; }
</style>

{% template meteoswiss %}
{%- assign chart_id = "chart-" | append_random -%}
{%- assign chart2_id = "chart-" | append_random -%}
{%- assign freshness_id = "freshness-" | append_random -%}
{%- if layout == "full" -%}
  {%- assign icon_size = 36 -%}
  {%- assign chart_duration = 129600000  -%}
{%- elsif layout == "horizontal" -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- elsif layout == "vertical" -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- else -%}
  {%- assign icon_size = 24 -%}
  {%- assign chart_duration = 93600000 -%}
{%- endif -%}
{%- if layout == "horizontal" -%}
  {%- assign tick_px = 80 -%}
{%- elsif layout == "vertical" or layout == "quadrant" -%}
  {%- assign tick_px = 70 -%}
{%- else -%}
  {%- assign tick_px = 55 -%}
{%- endif -%}
{%- if layout == "quadrant" -%}
  {%- assign compact = true -%}
{%- else -%}
  {%- assign compact = false -%}
{%- endif -%}
{%- if layout == "quadrant" or layout == "vertical" -%}
  {%- assign unit_labels = true -%}
  {%- assign margin_left = 38 -%}
  {%- assign margin_right = 32 -%}
{%- elsif layout == "horizontal" -%}
  {%- assign unit_labels = false -%}
  {%- assign margin_left = "undefined" -%}
  {%- assign margin_right = "undefined" -%}
{%- else -%}
  {%- assign unit_labels = false -%}
  {%- assign margin_left = 60 -%}
  {%- assign margin_right = 60 -%}
{%- endif -%}
{%- if layout == "vertical" or compact -%}
  {%- assign text_class = "label lg:label--large" -%}
{%- else -%}
  {%- assign text_class = "title lg:title--large portrait:label--base lg:portrait:title--large" -%}
{%- endif -%}
{%- comment -%} narrow portrait screens stack the days like the vertical layout {%- endcomment -%}
{%- if layout == "vertical" -%}
  {%- assign day_class = "flex flex--col gap--none" -%}
  {%- assign head_class = "gap--[4px]" -%}
  {%- assign img_class = "w--6 h--6 lg:w--9 lg:h--9" -%}
{%- else -%}
  {%- assign day_class = "flex flex--row gap--xsmall portrait:flex--col portrait:gap--none lg:portrait:flex--row lg:portrait:gap--xsmall" -%}
  {%- assign head_class = "gap--xsmall" -%}
  {%- if compact -%}
    {%- assign img_class = "w--7 h--7 portrait:w--6 portrait:h--6 lg:w--9 lg:h--9 lg:portrait:w--9 lg:portrait:h--9" -%}
  {%- else -%}
    {%- assign img_class = "w--9 h--9 portrait:w--6 portrait:h--6 lg:w--12 lg:h--12 lg:portrait:w--12 lg:portrait:h--12" -%}
  {%- endif -%}
{%- endif -%}
<div class="layout layout--col gap--none">
  <div class="forecast flex flex--row flex--around gap--[24px] pb--1 mb--1 w--full border--h-40">
    {%- for day in forecast -%}
      <div class="{{ day_class }}">
        <span class="flex flex--row {{ head_class }}">
          <span class="{{ text_class }} font--bold">{%- if forloop.first -%}Today{%- else -%}{{ day.dayDate | date: '%a' }}{%- endif -%}</span>
          {%- if forloop.first -%}
            <span class="{{ text_class }} font--bold">{{ currentWeather.temperature | round }}°</span>
          {%- endif -%}
          <img class="{{ img_class }}" data-code="{{ day.iconDayV2 }}" />
        </span>
        <span class="{{ text_class }} font--regular">{{ day.temperatureMin }}°|{{ day.temperatureMax }}°</span>
      </div>
    {%- endfor -%}
  </div>
  <div class="flex {% if layout == "horizontal" %}charts--row flex--row portrait:flex--col lg:portrait:flex--row{% else %}flex--col{% endif %} flex--stretch gap--none grow basis--0 h--min-0 w--full">
    <div id="{{ chart_id }}" class="chart--primary h--min-0 w--min-0"></div>
    {%- if layout != "quadrant" -%}
      <div id="{{ chart2_id }}" class="chart--secondary h--min-0 w--min-0"></div>
    {%- endif -%}
  </div>
</div>

<div class="title_bar">
  <span class="title">MeteoSwiss · {{ trmnl.plugin_settings.custom_fields_values.location_name }}</span>
  <span class="instance" id="{{ freshness_id }}"></span>
</div>
<script>
(() => {
  {%- assign now = 'now' | date: '%s' | minus: 3600 | times: 1000 -%}
  {%- assign end = now | plus: chart_duration -%}
  // Weather Icons by Erik Flowers, as hosted by TRMNL
  const ICON_BASE = 'https://trmnl.com/images/plugins/weather/wi-';

  // MeteoSwiss weather code -> Weather Icons name
  const weatherIcons = {
    '1': 'day-sunny',
    '2': 'day-sunny-overcast',
    '3': 'day-cloudy',
    '4': 'day-cloudy',
    '5': 'cloudy',
    '6': 'day-sleet',
    '7': 'day-rain-mix',
    '8': 'day-snow',
    '9': 'day-showers',
    '10': 'day-rain-mix',
    '11': 'day-snow-wind',
    '12': 'day-lightning',
    '13': 'day-storm-showers',
    '14': 'showers',
    '15': 'night-sleet',
    '16': 'snow-wind',
    '17': 'rain',
    '18': 'sleet',
    '19': 'snow',
    '20': 'rain',
    '21': 'rain-mix',
    '22': 'snow',
    '23': 'thunderstorm',
    '24': 'thunderstorm',
    '25': 'thunderstorm',
    '26': 'day-cloudy-high',
    '27': 'day-haze',
    '28': 'fog',
    '29': 'day-sleet',
    '30': 'day-snow-wind',
    '31': 'day-rain-mix',
    '32': 'day-showers',
    '33': 'day-rain',
    '34': 'day-snow',
    '35': 'cloudy',
    '36': 'day-sleet-storm',
    '37': 'day-snow-thunderstorm',
    '38': 'day-storm-showers',
    '39': 'day-snow-thunderstorm',
    '40': 'lightning',
    '41': 'day-lightning',
    '42': 'day-snow-thunderstorm',
    '51': 'night-clear',
    '52': 'night-alt-partly-cloudy',
    '53': 'night-alt-cloudy',
    '54': 'night-alt-cloudy',
    '55': 'cloudy',
    '56': 'night-alt-sleet',
    '57': 'night-alt-rain-mix',
    '58': 'night-alt-snow',
    '59': 'night-alt-showers',
    '60': 'night-alt-rain-mix',
    '61': 'night-alt-snow',
    '62': 'night-alt-lightning',
    '63': 'night-alt-storm-showers',
    '64': 'showers',
    '65': 'rain-mix',
    '66': 'snow',
    '67': 'rain',
    '68': 'rain-mix',
    '69': 'snow',
    '70': 'rain',
    '71': 'rain-mix',
    '72': 'snow',
    '73': 'storm-showers',
    '74': 'storm-showers',
    '75': 'storm-showers',
    '76': 'night-alt-cloudy-high',
    '77': 'night-fog',
    '78': 'fog',
    '101': 'night-clear',
    '102': 'night-alt-partly-cloudy',
    '103': 'night-alt-cloudy',
    '104': 'night-alt-cloudy',
    '105': 'cloudy',
    '106': 'night-alt-sleet',
    '107': 'night-alt-rain-mix',
    '108': 'night-alt-snow',
    '109': 'night-alt-showers',
    '110': 'night-alt-rain-mix',
    '111': 'night-alt-snow',
    '112': 'night-alt-lightning',
    '113': 'night-alt-storm-showers',
    '114': 'showers',
    '115': 'rain-mix',
    '116': 'snow',
    '117': 'rain',
    '118': 'rain-mix',
    '119': 'snow',
    '120': 'rain',
    '121': 'rain-mix',
    '122': 'snow',
    '123': 'storm-showers',
    '124': 'storm-showers',
    '125': 'storm-showers',
    '126': 'night-alt-cloudy-high',
    '127': 'night-fog',
    '128': 'fog',
    '129': 'night-alt-sleet',
    '130': 'night-alt-snow-wind',
    '131': 'night-alt-rain-mix',
    '132': 'night-alt-showers',
    '133': 'night-alt-rain',
    '134': 'night-alt-snow',
    '135': 'cloudy',
    '136': 'night-alt-sleet-storm',
    '137': 'night-alt-snow-thunderstorm',
    '138': 'night-alt-thunderstorm',
    '139': 'night-alt-snow-thunderstorm',
    '140': 'night-alt-lightning',
    '141': 'night-alt-lightning',
    '142': 'night-alt-snow-thunderstorm',
  };

  // takes the ink color of the screen, so it also works in dark mode and themes
  function adapt(img, src) {
    img.src = src;
    img.classList.add('image--adaptive');
    img.dataset.adaptive = 'true';
    img.style.setProperty('--framework-icon-src', `url('${src}')`);
    return img;
  }

  function iconTag(src, size) {
    const img = adapt(size ? new Image(size, size) : new Image(), src);
    // not accepted by the Highcharts HTML sanitizer
    img.removeAttribute('data-adaptive');
    return img.outerHTML;
  }

  function weatherIconUrl(code) {
    const name = weatherIcons[code];
    return name ? `${ICON_BASE}${name}.svg` : null;
  }

  document.querySelectorAll('.forecast img').forEach((img) => {
    const src = weatherIconUrl(img.dataset.code);
    if (src) adapt(img, src);
  });

  // show as many forecast days as fit the width
  function fitForecast() {
    document.querySelectorAll('.forecast').forEach((strip) => {
      const days = [...strip.children];
      days.forEach((d) => d.classList.remove('hidden'));
      while (days.length > 1 && strip.scrollWidth > strip.clientWidth) {
        days.pop().classList.add('hidden');
      }
    });
  }
  fitForecast();
  document.fonts.ready.then(fitForecast);
  window.addEventListener('load', fitForecast);

  const TIMEZONE = '{{ trmnl.user.time_zone_iana | default: "Europe/Zurich" }}';
  Highcharts.setOptions({ time: { timezone: TIMEZONE }, lang: { locale: 'en-GB' } });

  // local midnights
  const time = new Highcharts.Time({ timezone: TIMEZONE });
  const midnights = [];
  for (let t = Math.floor({{ now }} / 3600000) * 3600000; t <= {{ end }}; t += 3600000) {
    if (time.dateFormat('%H', t) === '00') midnights.push(t);
  }

  // time of the forecast data, then time the screen was drawn
  const dataTime = time.dateFormat('%H:%M', {{ currentWeather.time }});
  const drawnTime = time.dateFormat('%H:%M', {{ trmnl.system.timestamp_utc | times: 1000 }});
  document.getElementById('{{ freshness_id }}').textContent = `${dataTime} (${drawnTime})`;

  // 10 minute values first, then hourly ones once the detailed forecast ends
  const precipitation = [
    {%- assign last_timestamp = now -%}
    {%- for p in graph.precipitation10m -%}
      {%- assign offset = forloop.index0 | times: 600000 -%}
      {%- assign timestamp = graph.start | plus: offset -%}
      {%- if timestamp >= now and timestamp <= end -%}
        [{{ timestamp }}, {{ p }}],
        {%- assign last_timestamp = timestamp -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for p in graph.precipitation1h -%}
      {%- assign offset = forloop.index0 | times: 3600000 -%}
      {%- assign timestamp = graph.startLowResolution | plus: offset -%}
      {%- if timestamp > last_timestamp and timestamp <= end -%}
        [{{ timestamp }}, {{ p }}],
      {%- endif -%}
    {%- endfor -%}
  ];
  const precipitationMax = [
    {%- assign last_timestamp = now -%}
    {%- for p in graph.precipitationMax10m -%}
      {%- assign offset = forloop.index0 | times: 600000 -%}
      {%- assign timestamp = graph.start | plus: offset -%}
      {%- if timestamp >= now and timestamp <= end -%}
        [{{ timestamp }}, {{ p }}],
        {%- assign last_timestamp = timestamp -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for p in graph.precipitationMax1h -%}
      {%- assign offset = forloop.index0 | times: 3600000 -%}
      {%- assign timestamp = graph.startLowResolution | plus: offset -%}
      {%- if timestamp > last_timestamp and timestamp <= end -%}
        [{{ timestamp }}, {{ p }}],
      {%- endif -%}
    {%- endfor -%}
  ];
  // the name is the weather code of the icon shown every third hour
  const temperature = [
    {%- for t in graph.temperatureMean1h -%}
      {%- assign symbolIndex = forloop.index0 | divided_by: 3 -%}
      {%- assign showSymbol = forloop.index0 | modulo: 3 -%}
      {%- assign offset = forloop.index0 | times: 3600000 -%}
      {%- assign timestamp = graph.start | plus: offset -%}
      {%- if timestamp >= now and timestamp <= end -%}
        {x: {{ timestamp }}, y: {{ t }}, name: '{%- if showSymbol == 0 -%}{{ graph.weatherIcon3hV2[symbolIndex] }}{%- endif -%}'},
      {%- endif -%}
    {%- endfor -%}
  ];
  {%- if layout != "quadrant" -%}
    const sunshine = [
      {%- for s in graph.sunshine1h -%}
        {%- assign offset = forloop.index0 | times: 3600000 -%}
        {%- assign timestamp = graph.start | plus: offset -%}
        {%- if timestamp >= now and timestamp <= end -%}
          [{{ timestamp }}, {{ s }}],
        {%- endif -%}
      {%- endfor -%}
    ];
    const wind = [
      {%- for w in graph.windSpeed1h -%}
        {%- assign offset = forloop.index0 | times: 3600000 -%}
        {%- assign timestamp = graph.start | plus: offset -%}
        {%- if timestamp >= now and timestamp <= end -%}
          [{{ timestamp }}, {{ w }}],
        {%- endif -%}
      {%- endfor -%}
    ];
    const gust = [
      {%- for g in graph.gustSpeed1h -%}
        {%- assign offset = forloop.index0 | times: 3600000 -%}
        {%- assign timestamp = graph.start | plus: offset -%}
        {%- if timestamp >= now and timestamp <= end -%}
          [{{ timestamp }}, {{ g }}],
        {%- endif -%}
      {%- endfor -%}
    ];
  {%- endif -%}

  // precipitation is drawn as stacked bands, darker with the intensity in mm/h
  const bands = [
    { max: 1, paint: 'gray-6' },
    { max: 2, paint: 'gray-5' },
    { max: 4, paint: 'gray-4' },
    { max: 6, paint: 'gray-3' },
    { max: 10, paint: 'gray-2' },
    { max: Infinity, paint: 'gray-1' }
  ];

  // options shared by both charts, resolved for the device, mode and theme of the screen
  function setup(el) {
    // sizes are stepped up on large screens such as the TRMNL X
    const lg = document.getElementById(el).closest('.screen--lg') ? 1.25 : 1;
    const px = (v) => Math.round(TRMNLPaint.px(v * lg, { el }));
    const ink = TRMNLCharts.paint('black', { el });
    const label = { ...TRMNLCharts.textStyle('label', { el }), fontSize: `${px(16)}px`, fontWeight: '400', fontVariationSettings: 'normal' };
    const unit = { ...TRMNLCharts.textStyle('label--small', { el }), fontSize: `${px(12)}px`, whiteSpace: 'nowrap' };
    const defaults = TRMNLCharts.options({ el });

    // a unit with its icon above the axis on narrow layouts, a rotated title along it otherwise
    const title = (text, icon, x) => ({
      {%- if unit_labels -%}
        text: `<span class="flex flex--row gap--[2px]">${iconTag(ICON_BASE + icon, px(20))}${text}</span>`,
        useHTML: true,
        align: 'high',
        rotation: 0,
        offset: 0,
        x: px(x),
        y: px(-14),
      {%- else -%}
        text,
        {%- if layout == "horizontal" -%}
          margin: px(8),
        {%- endif -%}
      {%- endif -%}
      style: unit
    });
    const yAxis = (options) => TRMNLCharts.merge(defaults.yAxis, TRMNLCharts.merge({
      alignTicks: false,
      lineWidth: 1,
      gridLineWidth: 0,
      tickWidth: 1,
      tickLength: 4,
      labels: {
        {%- if layout != "full" -%}
          distance: 6,
        {%- endif -%}
        style: { ...label, textOverflow: 'none' }
      }
    }, options));

    const options = TRMNLCharts.merge(defaults, {
      chart: {
        spacing: [{% if unit_labels %}px(24){% else %}px(10){% endif %}, 0, 4, 0],
        {%- if margin_left != "undefined" -%}
          marginLeft: px({{ margin_left }}),
          marginRight: px({{ margin_right }}),
        {%- endif -%}
        style: { fontFamily: label.fontFamily }
      },
      xAxis: {
        type: 'datetime',
        gridLineWidth: 0,
        tickWidth: 1,
        tickLength: 4,
        tickPixelInterval: px({{ tick_px }}),
        dateTimeLabelFormats: { hour: '%[HM]', day: '%[eb]' },
        labels: {
          style: { ...label, textOverflow: 'none', whiteSpace: 'nowrap' },
          autoRotation: undefined
        },
        plotLines: midnights.map((value) => ({ value, color: ink, dashStyle: 'Dot' }))
      },
      plotOptions: {
        series: { animation: false },
        line: { lineWidth: px(2) },
        area: { step: 'left' }
      }
    });
    return { px, ink, title, yAxis, options };
  }

  // the framework's chart helper is part of the plugin runtime, which loads after this script
  function whenReady(cb) {
    let tries = 0;
    (function attempt() {
      if (window.TRMNLCharts && window.TRMNLPaint) return cb();
      if (++tries > 200) return;
      setTimeout(attempt, 50);
    })();
  }

  whenReady(() => {
    TRMNLCharts.watch('{{ chart_id }}', () => {
      const el = '{{ chart_id }}';
      const { px, ink, title, yAxis, options } = setup(el);
      return Highcharts.chart(el, TRMNLCharts.merge(options, {
        yAxis: [
          yAxis({
            plotLines: [0, 20, 30].map((value) => ({ value, color: ink, dashStyle: 'Dot' })),
            title: title({% if unit_labels %}'°C', 'thermometer.svg', {{ 45 | minus: margin_left }}{% else %}'Temp. [°C]'{% endif %})
          }),
          yAxis({
            title: title({% if unit_labels %}'mm/h', 'raindrop.svg', {{ margin_right | minus: 67 }}{% elsif layout == "horizontal" %}'Rain [mm/h]'{% else %}'Precip. [mm/h]'{% endif %}),
            opposite: true,
            min: 0,
            minRange: 5
          })
        ],
        series: [
          ...bands.map((band, i) => ({
            name: `Precipitation up to ${band.max}`,
            type: 'area',
            yAxis: 1,
            color: TRMNLCharts.paint(band.paint, { el }),
            lineWidth: band.max === Infinity ? 1 : 0,
            lineColor: ink,
            zIndex: bands.length - i,
            data: precipitation.map(([t, p]) => [t, Math.min(p, band.max)])
          })),
          {
            name: 'Precipitation outline',
            type: 'area',
            yAxis: 1,
            color: 'transparent',
            lineWidth: 1,
            lineColor: ink,
            zIndex: 7,
            data: precipitationMax
          }, {
            name: 'Temperature',
            type: 'line',
            color: ink,
            zIndex: 8,
            data: temperature,
            dataLabels: {
              enabled: true,
              useHTML: true,
              y: -10000,
              align: 'left',
              formatter: function() {
                const src = this.point.name ? weatherIconUrl(this.point.name) : null;
                return src ? iconTag(src, px({{ icon_size }})) : '';
              }
            }
          }
        ]
      }));
    });
    {%- if layout != "quadrant" -%}
      TRMNLCharts.watch('{{ chart2_id }}', () => {
        const el = '{{ chart2_id }}';
        const { ink, title, yAxis, options } = setup(el);
        const gray = TRMNLCharts.paint('gray-3', { el });
        // a patterned stroke is unreadable, fall back to a thin ink line
        const gustLine = typeof gray === 'string' ? { color: gray } : { color: ink, lineWidth: 1 };
        return Highcharts.chart(el, TRMNLCharts.merge(options, {
          yAxis: [
            yAxis({
              title: title({% if unit_labels %}'km/h', 'strong-wind.svg', {{ 62 | minus: margin_left }}{% else %}'Wind [km/h]'{% endif %})
            }),
            yAxis({
              title: title({% if unit_labels %}'min/h', 'day-sunny.svg', {{ margin_right | minus: 67 }}{% else %}'Sun [min/h]'{% endif %}),
              opposite: true,
              tickInterval: 15,
              min: 0,
              max: 60
            })
          ],
          series: [
            {
              name: 'Sunshine',
              type: 'area',
              yAxis: 1,
              color: TRMNLCharts.paint('gray-5', { el }),
              lineWidth: 1,
              lineColor: ink,
              zIndex: 1,
              data: sunshine
            }, {
              name: 'Wind',
              type: 'line',
              color: ink,
              zIndex: 3,
              data: wind
            }, {
              name: 'Gust',
              type: 'line',
              ...gustLine,
              zIndex: 2,
              data: gust
            }
          ]
        }));
      });
    {%- endif -%}
  });
})();
</script>
{% endtemplate %}
